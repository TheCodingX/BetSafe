# BetSafe — Variables de entorno (template)
# ============================================================================
# Copiá este archivo como `.env` y completá con tus keys reales.
# NUNCA pushees `.env` al repo público — agregalo a .gitignore.
#
# En producción (Render), estas mismas vars se cargan en
# Dashboard → Environment → Add Variable.
# ============================================================================

# ─────── Backend ───────
PORT=8787

# ─────── Fuente primaria: The Odds API ───────
# https://the-odds-api.com → free 500 req/mes, plan $30 = 50k/mes.
# Sin esta key, el sistema depende 100% de scrapers (más frágil).
THE_ODDS_API_KEY=
# Region: 'eu' cubre Betano + Bet365 + Betsson. 'us' para NFL/MLB/NBA.
# 'uk' para coverage adicional. Default: eu (mejor para AR).
ODDSAPI_REGION=eu
# Sports a polear (comma-separated). Menos sports = menos quota consumida.
ODDSAPI_SPORTS=soccer_argentina_primera_division,soccer_conmebol_copa_libertadores,soccer_conmebol_copa_sudamericana,soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_uefa_champs_league,basketball_nba,americanfootball_nfl,baseball_mlb,icehockey_nhl,tennis_atp,mma_mixed_martial_arts

# ─────── Scrapers (fallback) ───────
# Cada cuántos ms corre el ciclo completo (12 scrapers en paralelo).
# Mínimo realista: 15000 (15s). Recomendado: 30000 (30s).
# Por debajo de 15s = ban casi garantizado por anti-bot.
SCRAPE_INTERVAL_MS=30000
# Casas habilitadas (comma-separated). Mismos IDs que /server/scrapers/<id>.js
ENABLED_BOOKS=bplay,betano,betwarrior,bet365ar,codere,caliente,casinomagic,betsson,playcity,super7,betfun,jugadon
# CORS para split-deploy. En single-deploy queda '*'.
CORS_ORIGIN=*

# ─────── Motor de arbitraje hiper-preciso ───────
# Cada cuántos ms re-evalúa el motor de arbitraje cross-market.
# 5s = excelente. <2s no aporta más (mercados no se mueven tan rápido).
ARB_INTERVAL_MS=5000

# ─────── Factors (clima, lesiones, histórico) ───────
# OpenWeatherMap: https://openweathermap.org/api → free 1000 calls/día.
# Sin esta key, el factor clima queda como "unavailable" pero el resto funciona.
OPENWEATHER_API_KEY=

# API-Football (lesiones reportadas). DOS formas de auth, elegí UNA:
#   A) Directa (RECOMENDADA): https://dashboard.api-football.com/register
#      Después de registrarte → My Access → copiá la key acá.
APISPORTS_KEY=
#   B) Via RapidAPI: https://rapidapi.com/api-sports/api/api-football
RAPIDAPI_KEY=
# Sin ninguna de las dos, las lesiones caen a ESPN scrape (best-effort).

# ─────── IA (cascada client-side: Groq → Gemini → OpenRouter → offline) ───────
# Groq → https://console.groq.com (free, 30 req/min)
BS_GROQ_API_KEY=
# Gemini → https://aistudio.google.com/app/apikey (free tier generoso)
BS_GEMINI_API_KEY=
# OpenRouter → https://openrouter.ai/keys (free models)
BS_OPENROUTER_API_KEY=

# ─────── Football-data.org (opcional: fixtures suplementarios) ───────
# https://www.football-data.org/client/register (free 10 req/min)
BS_FOOTBALL_DATA_API_KEY=

# ─────── Supabase (opcional: auth + DB persistente) ───────
BS_SUPABASE_URL=
BS_SUPABASE_ANON_KEY=

# ─────── Split-deploy (opcional) ───────
# Si separás frontend (Netlify/Vercel) del backend (Render), setear acá la URL
# pública del backend para que el frontend lo encuentre. En single-deploy queda vacío.
BS_API_BASE=

# ============================================================================
# NOTAS DE OPERACIÓN
# - Los scrapers usan Playwright headless. Render Standard tiene los recursos
#   necesarios (~512MB RAM por scraper en simultáneo). Free tier hiberna a los
#   15min sin tráfico — no recomendado para scraping continuo.
# - WebSocket: el cliente reconecta automáticamente con backoff. El servidor
#   pingea cada 30s para detectar conexiones muertas.
# - Detección de surebets / steam moves corre en CADA ciclo, no es batch.
# ============================================================================
