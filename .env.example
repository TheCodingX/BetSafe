# BetSafe — Variables de entorno (template)
# ============================================================================
# Copiá este archivo como `.env` y completá con TUS keys reales.
# NUNCA pushees `.env` al repo público — agregalo a .gitignore.
#
# En producción (Render), estas mismas vars se cargan en
# Dashboard → Environment → Add Variable.
# ============================================================================

# ─────── Odds + datos deportivos ───────
# The Odds API → https://the-odds-api.com (free 500 req/mes)
BS_ODDS_API_KEY=

# Football-data.org → https://www.football-data.org/client/register (free 10 req/min)
# Opcional, suma datos de fixtures/standings/lesiones
BS_FOOTBALL_DATA_API_KEY=

# ─────── AI / LLM (cascada con fallback) ───────
# Groq → https://console.groq.com (free, 30 req/min, models llama-3.x)
BS_GROQ_API_KEY=

# Gemini → https://aistudio.google.com/app/apikey (free tier generoso)
BS_GEMINI_API_KEY=

# OpenRouter → https://openrouter.ai/keys (free models disponibles)
BS_OPENROUTER_API_KEY=

# ─────── Supabase (auth + DB + realtime) ───────
# Crear proyecto en https://supabase.com → Settings → API
BS_SUPABASE_URL=
BS_SUPABASE_ANON_KEY=

# ============================================================================
# IMPORTANTE
# - El frontend lee estas keys desde window.__BS_CONFIG en runtime
# - El build step (build/inject-env.js) lee process.env.BS_* y reemplaza
#   los placeholders en build/env.js antes del deploy
# - Sin estas vars la app funciona en modo demo (mocks + offline)
# - Después de deployar, ROTÁ las keys que ya están hardcodeadas en api.js
#   (porque están expuestas en el commit history)
# ============================================================================
