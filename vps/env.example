# ============================================================================
# BetSafe Backend — Environment Variables
# ============================================================================
# Copiá este archivo a `.env` en el directorio server/ y completá los valores.
# Los valores los sacás del dashboard de Render → tu servicio betsafe →
# sidebar "Environment" → ahí están las API keys actuales.
# ============================================================================

# Server config
PORT=8787
NODE_ENV=production

# Bookmakers habilitados (todos los AR)
ENABLED_BOOKS=bplay,betano,betwarrior,bet365ar,codere,betsson
SCRAPE_INTERVAL_MS=30000

# === Data APIs ===
THE_ODDS_API_KEY=
APISPORTS_KEY=
SCRAPINGBEE_KEY=
RAPIDAPI_KEY=
OPENWEATHER_API_KEY=
BS_FOOTBALL_DATA_API_KEY=

# === IA Providers ===
BS_GEMINI_API_KEY=
BS_GROQ_API_KEY=
BS_OPENROUTER_API_KEY=
BS_ANTHROPIC_API_KEY=

# === Supabase (DB + Auth) ===
BS_SUPABASE_URL=
BS_SUPABASE_ANON_KEY=

# === Cloudflare Worker Proxy ===
# (Usado por scrapers para sortear geo-block — pre-configurado)
CF_PROXY_URL=https://betsafe-proxy.betwinadmins.workers.dev
CF_PROXY_KEY=adc9e41349bb1c76b973bbe681f172126af9b8f4dcedb7b5f09b6445abe3c1df

# === Opcionales ===
# DISABLE_BETSSON_SCRAPER=false
# ENABLE_BET365_SCRAPER=false
# PICKS_CONCURRENCY=4
